    m_Localized: "\u0414\u0430\u043D\u043D\u044B\u0435 \u0438\u0433\u0440\u044B \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0438\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793886
    m_Localized: "\u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u0441\u0434\u0435\u043B\u0430\u043D\u043E \u0441 \u0434\u0440\u0443\u0433\u0438\u043C \u0431\u0430\u043B\u0430\u043D\u0441\u043E\u043C \u0438\u0433\u0440\u044B, \u0438 \u043F\u0430\u0440\u0442\u0438\u044F \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0439\u0442\u0438 \u0438\u043D\u0430\u0447\u0435, \u0447\u0435\u043C \u0431\u044B\u043B\u0430. \u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793887
    m_Localized: "\u0422\u0430 \u0436\u0435 \u0444\u0430\u0431\u0440\u0438\u043A\u0430 \u0441 \u0440\u0430\u0437\u043D\u044B\u043C\u0438 \u043C\u043E\u0434\u0443\u043B\u044F\u043C\u0438 \u0446\u0438\u0444\u0440\u043E\u0432\u0438\u0437\u0430\u0446\u0438\u0438, \u0431\u0435\u0437 \u0433\u0440\u0430\u0444\u0438\u043A\u0438. \u042D\u0444\u0444\u0435\u043A\u0442 \u2014 \u0440\u0430\u0437\u043D\u0438\u0446\u0430 \u043F\u0440\u0438\u0431\u044B\u043B\u0438 \u0441 \u0431\u0430\u0437\u043E\u0439 \u043D\u0430 \u0442\u0435\u0445 \u0436\u0435 seed."
