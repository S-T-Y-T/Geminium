  - m_Id: 330932966576143
    m_Localized: "\u0420\u043E\u0437\u043D\u0438\u0446\u0430 (B2C)"
    m_Metadata:
      m_Items: []
  - m_Id: 330932966576144
    m_Localized: "\u0426\u0435\u043D\u044B \u0432\u044B\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0418\u0418-\u043C\u043E\u0434\u0443\u043B\u044C (\u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u043D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435 \xAB\u0426\u0438\u0444\u0440\u043E\u0432\u0438\u0437\u0430\u0446\u0438\u044F\xBB)."
    m_Metadata:
      m_Items: []
  - m_Id: 330932966576145
    m_Localized: "\u041F\u0440\u043E\u0448\u043B\u044B\u0439 \u043C\u0435\u0441\u044F\u0446: \u043F\u0440\u043E\u0434\u0430\u043D\u043E {0}, \u0443\u043F\u0443\u0449\u0435\u043D\u043E {1}, \u0434\u043E\u043B\u044F \u0440\u044B\u043D\u043A\u0430 {2}. \u041D\u0430 \u0441\u043A\u043B\u0430\u0434\u0435 {3}."
    m_Metadata:
      m_Items: []
  - m_Id: 330932966576146
    m_Localized: "\u0426\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 330932966576147
    m_Localized: "\u041F\u043B\u0430\u043D/\u043C\u0435\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 330932966576148
    m_Localized: "\u042D\u0442\u0430\u043B\u043E\u043D\u043D\u0430\u044F \u0446\u0435\u043D\u0430 \u0440\u044B\u043D\u043A\u0430: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 330932966576149
    m_Localized: "\u0422\u0435\u043D\u0434\u0435\u0440\u044B (B2B)"
    m_Metadata:
      m_Items: []
  - m_Id: 330932974964736
    m_Localized: "\u0412 \u044D\u0442\u043E\u043C \u043C\u0435\u0441\u044F\u0446\u0435 \u0442\u0435\u043D\u0434\u0435\u0440\u043E\u0432 \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 330932974964737
    m_Localized: "{0}: {1}, {2} \u0448\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 330932974964738
    m_Localized: "\u041F\u0440\u0435\u0434\u0435\u043B\u044C\u043D\u0430\u044F \u0446\u0435\u043D\u0430 {0} \u0437\u0430 \u0448\u0442\u0443\u043A\u0443, \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u0437\u0430 {1} \u043C\u0435\u0441. \u043F\u043E\u0441\u043B\u0435 \u0438\u0442\u043E\u0433\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 330932974964739
    m_Localized: "\u0412\u0430\u0448\u0430 \u0446\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 330932974964740
    m_Localized: "\u041F\u043E\u0434\u0430\u0442\u044C \u0437\u0430\u044F\u0432\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 330932974964741
    m_Localized: "\u0418\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0437\u0430\u044F\u0432\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 330932974964742
    m_Localized: "\u0417\u0430\u044F\u0432\u043A\u0430 \u043F\u043E\u0434\u0430\u043D\u0430: {0} \u0437\u0430 \u0448\u0442\u0443\u043A\u0443. \u0418\u0442\u043E\u0433\u0438 \u2014 \u0432 \u043A\u043E\u043D\u0446\u0435 \u043C\u0435\u0441\u044F\u0446\u0430."
    m_Metadata:
      m_Items: []
