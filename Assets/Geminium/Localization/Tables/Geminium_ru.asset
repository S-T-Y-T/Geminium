    m_Localized: "{0}, \u043C\u0435\u0441\u044F\u0446 {1}, \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F {2} \xB7 {3}"
    m_Metadata:
