      m_Items: []
  - m_Id: 330932945604625
    m_Localized: "\u0414\u0438\u0430\u0433\u0440\u0430\u043C\u043C\u0430 \u0441\u043F\u0430\u0433\u0435\u0442\u0442\u0438 \u0437\u0430 \u043D\u0435\u0434\u0435\u043B\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 330932945604626
    m_Localized: "\u0417\u043E\u043D\u044B \u0438 \u043F\u0440\u043E\u0445\u043E\u0434\u044B \u0440\u0438\u0441\u0443\u044E\u0442\u0441\u044F \u043F\u0440\u043E\u0442\u044F\u0436\u043A\u043E\u0439 \u043C\u044B\u0448\u0438, \u043E\u0431\u044A\u0435\u043A\u0442\u044B \u0441\u0442\u0430\u0432\u044F\u0442\u0441\u044F \u043A\u043B\u0438\u043A\u043E\u043C. \u041A\u0430\u043C\u0435\u0440\u0430: WASD, \u043A\u043E\u043B\u0435\u0441\u043E \u043C\u044B\u0448\u0438, \u043F\u0440\u0430\u0432\u0430\u044F \u043A\u043D\u043E\u043F\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 330932945604627
    m_Localized: "\u0412\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u0439 \u043E\u0431\u044A\u0435\u043A\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 330932945604628
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442 \xAB\u0412\u044B\u0431\u043E\u0440\xBB \u0438 \u043A\u043B\u0438\u043A\u043D\u0438\u0442\u0435 \u043F\u043E \u043E\u0431\u044A\u0435\u043A\u0442\u0443 \u0432 \u0446\u0435\u0445\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 330932945604629
    m_Localized: "\u0421\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 330932945604630
