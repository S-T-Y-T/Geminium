  - m_Id: 330932958187539
    m_Localized: "\xAB+5%\xBB \u2014 \u043F\u0440\u0438\u0431\u0430\u0432\u043A\u0430, \xAB\u0423\u0447\u0438\u0442\u044C\xBB \u2014 \u043A\u0443\u0440\u0441 \u0437\u0430 {0} (+\u043E\u043F\u044B\u0442), \xAB\u2715\xBB \u2014 \u0443\u0432\u043E\u043B\u0438\u0442\u044C. \u25CF \u2014 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u043D\u0430 \u0441\u0442\u0430\u043D\u043A\u0435."
