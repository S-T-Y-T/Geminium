      m_Items: []
  - m_Id: 330932933021697
    m_Localized: "\u041A\u0430\u043C\u043F\u0430\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 330932933021698
    m_Localized: "\u0428\u0435\u0441\u0442\u044C \u0437\u0430\u0434\u0430\u043D\u0438\u0439: \u043A\u0430\u0436\u0434\u043E\u0435 \u0443\u0447\u0438\u0442 \u043E\u0434\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u0438 \u0444\u0430\u0431\u0440\u0438\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 330932933021699
    m_Localized: "\u0421\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0439 \u0440\u0435\u0436\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 330932933021700
    m_Localized: "\u0422\u0440\u0438 \u0433\u043E\u0434\u0430 \u043F\u0440\u043E\u0442\u0438\u0432 Daebo \u0438 Ab\u0131das. \u041F\u043E\u0431\u0435\u0436\u0434\u0430\u0435\u0442 \u0441\u0430\u043C\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0430\u044F \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 330932933021701
    m_Localized: "\u041E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F \u043F\u043E\u0441\u043B\u0435 \u043A\u0430\u043C\u043F\u0430\u043D\u0438\u0438."
