    m_Localized: "\u043D\u0435\u0442 \u043B\u044E\u0434\u0435\u0439 {0} \xB7 \u043D\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u044B {1} \xB7 \u0440\u0435\u043C\u043E\u043D\u0442 {2} \xB7 \u0422\u041E {3}"
