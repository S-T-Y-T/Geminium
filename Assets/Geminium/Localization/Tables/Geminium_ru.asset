    m_Metadata:
      m_Items: []
  - m_Id: 330933092405267
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u043E\u0435\u0432 \u0438\u0437-\u0437\u0430 \u043F\u043E\u043B\u043E\u043C\u043E\u043A \u0438 \u0422\u041E \u2014 \u043D\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 {0} \u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 330933092405268
    m_Localized: "\u0414\u043E\u043B\u044F \u0440\u044B\u043D\u043A\u0430 \u2014 \u043D\u0435 \u043C\u0435\u043D\u044C\u0448\u0435 {0}% ({1})"
    m_Metadata:
      m_Items: []
  - m_Id: 330933092405269
    m_Localized: "\u0412\u044B\u0438\u0433\u0440\u0430\u0442\u044C \u0442\u0435\u043D\u0434\u0435\u0440 \u0444\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u0438 \u0438 \u0437\u0430\u043A\u0440\u044B\u0442\u044C \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u0432 \u0441\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 330933092405270
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0446\u0435\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 330933092405271
    m_Localized: "\u041F\u043E\u0441\u0442\u0440\u043E\u0439\u0442\u0435 \u0446\u0435\u0445 \u0438 \u0432\u044B\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u043F\u0435\u0440\u0432\u044B\u0435 \u0434\u043E\u0431\u043E\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 330933092405272
    m_Localized: "\u0423 \u0432\u0430\u0441 \u043F\u0443\u0441\u0442\u043E\u0439 \u0446\u0435\u0445 \u0438 80 \u043C\u043B\u043D \u0441\u0443\u043C. \u041F\u043E\u043A\u0440\u0430\u0441\u044C\u0442\u0435 \u0437\u043E\u043D\u044B \u0440\u0430\u0441\u043A\u0440\u043E\u044F \u0438 \u043F\u043E\u0448\u0438\u0432\u0430, \u043F\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u0441\u0442\u0430\u043D\u043A\u0438, \u043D\u0430\u0439\u043C\u0438\u0442\u0435 \u0440\u0430\u0441\u043A\u0440\u043E\u0439\u0449\u0438\u043A\u0430, \u0448\u0432\u0435\u044E \u0438 \u0440\u0430\u0437\u043D\u043E\u0440\u0430\u0431\u043E\u0447\u0435\u0433\u043E, \u0437\u0430\u043A\u0430\u0436\u0438\u0442\u0435 \u0445\u043B\u043E\u043F\u043E\u043A \u0438 \u043D\u0438\u0442\u043A\u0438, \u0437\u0430\u0434\u0430\u0439\u0442\u0435 \u043F\u043B\u0430\u043D \u0438 \u0446\u0435\u043D\u0443. \u0426\u0435\u043B\u044C \u2014 \u0432\u044B\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u043D\u0435 \u043C\u0435\u043D\u044C\u0448\u0435 250 \u0434\u043E\u0431\u043E\u043A\u043E\u0432 \u0437\u0430 \u0434\u0432\u0430 \u043C\u0435\u0441\u044F\u0446\u0430 \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0435\u0433\u043E \u0431\u0440\u0430\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 330933092405273
    m_Localized: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430: \u0437\u043E\u043D\u0443 \u0440\u0438\u0441\u0443\u0439\u0442\u0435 \u043F\u0440\u043E\u0442\u044F\u0436\u043A\u043E\u0439 \u043C\u044B\u0448\u0438, \u0441\u0442\u0430\u043D\u043E\u043A \u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u0432\u043D\u0443\u0442\u0440\u0438 \u0441\u0432\u043E\u0435\u0439 \u0437\u043E\u043D\u044B \u043F\u043E\u0434\u0445\u043E\u0434\u043E\u043C \u043A \u043F\u0440\u043E\u0445\u043E\u0434\u0443. \u041D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435 \xAB\u041F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\xBB \u0435\u0441\u0442\u044C \u043A\u043D\u043E\u043F\u043A\u0430 \xAB\u0420\u0430\u0441\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u043E\u0432\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 330933092405274
    m_Localized: "\u041B\u043E\u0433\u0438\u0441\u0442\u0438\u043A\u0430 \u0438 \u0441\u043A\u043B\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 330933092405275
    m_Localized: "\u041F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u0441\u0442\u0430\u043D\u043A\u0438 \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B \u0433\u0440\u0443\u0437\u044B \u0435\u0437\u0434\u0438\u043B\u0438 \u043C\u0435\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 330933092405276
    m_Localized: "\u0426\u0435\u0445 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442, \u043D\u043E \u0441\u0442\u0430\u043D\u043A\u0438 \u0441\u0442\u043E\u044F\u0442 \u0432 \u0434\u0430\u043B\u044C\u043D\u0438\u0445 \u043A\u043E\u043D\u0446\u0430\u0445 \u0437\u043E\u043D, \u0438 \u0440\u0430\u0437\u043D\u043E\u0440\u0430\u0431\u043E\u0447\u0438\u0435 \u0442\u0440\u0430\u0442\u044F\u0442 \u0432\u0440\u0435\u043C\u044F \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443. \u041F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u0441\u0442\u0430\u043D\u043A\u0438 \u0431\u043B\u0438\u0436\u0435 \u043A \u0441\u043A\u043B\u0430\u0434\u0443 \u0438 \u0434\u0440\u0443\u0433 \u043A \u0434\u0440\u0443\u0433\u0443, \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u0442\u0435 \u0441\u0442\u0435\u043B\u043B\u0430\u0436\u0438, \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u043F\u043E\u0434\u0430\u0447\u0438 \u0438 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u043D\u0443\u044E \u043F\u0430\u0440\u0442\u0438\u044E. \u0426\u0435\u043B\u044C \u2014 \u0441\u043E\u043A\u0440\u0430\u0442\u0438\u0442\u044C \u043F\u0443\u0442\u044C \u0433\u0440\u0443\u0437\u043E\u0432 \u043D\u0430 30% \u0438 \u043D\u0435 \u043F\u0435\u0440\u0435\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u0441\u043A\u043B\u0430\u0434, \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u0432 \u0432\u044B\u043F\u0443\u0441\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 330933092405277
    m_Localized: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430: \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \xAB\u0414\u0438\u0430\u0433\u0440\u0430\u043C\u043C\u0443 \u0441\u043F\u0430\u0433\u0435\u0442\u0442\u0438\xBB \u043D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435 \xAB\u0426\u0435\u0445\xBB \u2014 \u043A\u0440\u0430\u0441\u043D\u044B\u0435 \u043A\u043B\u0435\u0442\u043A\u0438 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0441\u0430\u043C\u044B\u0435 \u043D\u0430\u0433\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u044B. \u0418\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442 \xAB\u041F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u044C\xBB \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u0439 \u0441\u0442\u0430\u043D\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 330933092405278
    m_Localized: "\u041A\u0430\u0447\u0435\u0441\u0442\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 330933092405279
    m_Localized: "\u0421\u043D\u0438\u0437\u044C\u0442\u0435 \u0431\u0440\u0430\u043A \u0438 \u0443\u0431\u0435\u0440\u0438\u0442\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 330933092405280
    m_Localized: "\u0426\u0435\u0445 \u0441\u043E\u0431\u0440\u0430\u043D \u044D\u043A\u043E\u043D\u043E\u043C\u043D\u043E: \u0431\u0435\u0437 \u0441\u0442\u043E\u043B\u0430 \u041E\u0422\u041A \u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0451\u0440\u0430, \u0438 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442 \u0431\u0440\u0430\u043A. \u041F\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u0441\u0442\u043E\u043B \u041E\u0422\u041A, \u043D\u0430\u0439\u043C\u0438\u0442\u0435 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0451\u0440\u0430, \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0432\u0445\u043E\u0434\u043D\u043E\u0439 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u0441\u044B\u0440\u044C\u044F, \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C \u0441 \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u043C \u0431\u0440\u0430\u043A\u043E\u043C, \u043E\u0431\u0443\u0447\u0438\u0442\u0435 \u043B\u044E\u0434\u0435\u0439. \u0426\u0435\u043B\u044C \u2014 \u0431\u0440\u0430\u043A \u043D\u0435 \u0432\u044B\u0448\u0435 2,5% \u0438 \u043D\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u0430 \u0437\u0430 \u0434\u0432\u0430 \u043C\u0435\u0441\u044F\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 330933092405281
    m_Localized: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430: \u041E\u0422\u041A \u043D\u0430\u0445\u043E\u0434\u0438\u0442 \u0431\u0440\u0430\u043A \u0434\u043E \u043F\u0440\u043E\u0434\u0430\u0436\u0438, \u0430 \u0432\u0445\u043E\u0434\u043D\u043E\u0439 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u043D\u0435 \u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u0432 \u0446\u0435\u0445 \u043F\u043B\u043E\u0445\u043E\u0435 \u0441\u044B\u0440\u044C\u0451. \u0423\u0441\u0442\u0430\u043B\u044B\u0435 \u0438 \u043D\u0435\u043E\u043F\u044B\u0442\u043D\u044B\u0435 \u043B\u044E\u0434\u0438 \u043E\u0448\u0438\u0431\u0430\u044E\u0442\u0441\u044F \u0447\u0430\u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 330933092405282
    m_Localized: "\u041E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 330933092405283
    m_Localized: "\u0421\u0442\u0430\u043D\u043A\u0438 \u0438\u0437\u043D\u043E\u0448\u0435\u043D\u044B \u2014 \u043D\u0435 \u0434\u0430\u0439\u0442\u0435 \u0438\u043C \u0441\u043B\u043E\u043C\u0430\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 330933092405284
    m_Localized: "\u0412\u044B \u043A\u0443\u043F\u0438\u043B\u0438 \u0446\u0435\u0445 \u0441\u043E \u0441\u0442\u0430\u0440\u044B\u043C\u0438 \u0441\u0442\u0430\u043D\u043A\u0430\u043C\u0438: \u0438\u0445 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u2014 \u043E\u043A\u043E\u043B\u043E 1%. \u0411\u0435\u0437 \u043D\u0430\u043B\u0430\u0434\u0447\u0438\u043A\u0430 \u043F\u043B\u0430\u043D\u043E\u0432\u043E\u0435 \u0422\u041E \u043D\u0435 \u0434\u0435\u043B\u0430\u0435\u0442\u0441\u044F, \u0430 \u043F\u043E\u043B\u043E\u043C\u043A\u0430 \u043D\u0430\u0434\u043E\u043B\u0433\u043E \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442 \u0441\u0442\u0430\u043D\u043E\u043A. \u041D\u0430\u0439\u043C\u0438\u0442\u0435 \u043D\u0430\u043B\u0430\u0434\u0447\u0438\u043A\u0430, \u0437\u0430\u0434\u0430\u0439\u0442\u0435 \u0440\u0435\u0433\u043B\u0430\u043C\u0435\u043D\u0442 \u0422\u041E, \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0434\u0430\u0442\u0447\u0438\u043A\u0438 IoT \u0438 \u043F\u0440\u0435\u0434\u0438\u043A\u0442\u0438\u0432\u043D\u043E\u0435 \u0422\u041E, \u0435\u0441\u043B\u0438 \u0445\u0432\u0430\u0442\u0438\u0442 \u0434\u0435\u043D\u0435\u0433. \u0412 \u044D\u0442\u043E\u043C \u0437\u0430\u0434\u0430\u043D\u0438\u0438 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0444\u043E\u0440\u043C\u043E\u0432\u043A\u0430 \u0438 \u0448\u043B\u0435\u043C\u044B. \u0426\u0435\u043B\u044C \u2014 \u043F\u0440\u043E\u0441\u0442\u043E\u0438 \u0438\u0437-\u0437\u0430 \u043F\u043E\u043B\u043E\u043C\u043E\u043A \u0438 \u0422\u041E \u043D\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 2 \u0447\u0430\u0441\u043E\u0432 \u0437\u0430 \u0442\u0440\u0438 \u043C\u0435\u0441\u044F\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 330933092405285
    m_Localized: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430: \u043F\u0440\u0438 \u043E\u0434\u043D\u043E\u0439-\u0434\u0432\u0443\u0445 \u0441\u043C\u0435\u043D\u0430\u0445 \u043D\u0430\u043B\u0430\u0434\u0447\u0438\u043A \u0434\u0435\u043B\u0430\u0435\u0442 \u0422\u041E \u043C\u0435\u0436\u0434\u0443 \u0441\u043C\u0435\u043D\u0430\u043C\u0438, \u0431\u0435\u0437 \u043F\u0440\u043E\u0441\u0442\u043E\u044F. \u0420\u0435\u0433\u043B\u0430\u043C\u0435\u043D\u0442 \xAB\u0422\u041E \u043A\u0430\u0436\u0434\u0443\u044E 1 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u044E\xBB \u0441\u0440\u0430\u0437\u0443 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442 \u0441\u0442\u0430\u043D\u043E\u043A \u043D\u0430 \u0422\u041E \u2014 \u043F\u043E\u0442\u043E\u043C \u0432\u0435\u0440\u043D\u0438\u0442\u0435 \u043E\u0431\u044B\u0447\u043D\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793856
    m_Localized: "\u0420\u044B\u043D\u043E\u043A \u0438 \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793857
    m_Localized: "\u041E\u0442\u0432\u043E\u044E\u0439\u0442\u0435 \u0434\u043E\u043B\u044E \u0440\u044B\u043D\u043A\u0430 \u0443 Daebo \u0438 Ab\u0131das."
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793858
    m_Localized: "\u041D\u0430 \u0440\u044B\u043D\u043E\u043A \u0432\u044B\u0448\u043B\u0438 \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u044B: Daebo \u043F\u0440\u043E\u0434\u0430\u0451\u0442 \u0434\u043E\u0440\u043E\u0433\u043E \u0438 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E, Ab\u0131das \u2014 \u0434\u0451\u0448\u0435\u0432\u043E. \u041F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0438 \u0432\u044B\u0431\u0438\u0440\u0430\u044E\u0442 \u043F\u043E \u0446\u0435\u043D\u0435, \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0443 \u0438 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438. \u0423\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u0446\u0435\u043D\u0430\u043C\u0438 \u0438 \u043F\u043B\u0430\u043D\u043E\u043C, \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0439\u0442\u0435\u0441\u044C \u0432 \u0440\u0435\u043A\u043B\u0430\u043C\u0443, \u0441\u043F\u043E\u043D\u0441\u0438\u0440\u0443\u0439\u0442\u0435 \u0442\u0443\u0440\u043D\u0438\u0440\u044B, \u043F\u043E\u0434\u043F\u0438\u0448\u0438\u0442\u0435 \u0430\u043C\u0431\u0430\u0441\u0441\u0430\u0434\u043E\u0440\u0430. \u0426\u0435\u043B\u044C \u2014 \u0434\u043E\u043B\u044F \u0440\u044B\u043D\u043A\u0430 \u043D\u0435 \u043C\u0435\u043D\u044C\u0448\u0435 33% \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u043C \u043C\u0435\u0441\u044F\u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793859
    m_Localized: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430: \u0435\u0441\u043B\u0438 \u0442\u043E\u0432\u0430\u0440\u0430 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442, \u043F\u0440\u043E\u0434\u0430\u0436\u0438 \u0443\u0445\u043E\u0434\u044F\u0442 \u043A \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u0430\u043C. \u0421\u043B\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u0443\u043F\u0443\u0449\u0435\u043D\u043D\u044B\u043C\u0438 \u043F\u0440\u043E\u0434\u0430\u0436\u0430\u043C\u0438 \u043D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435 \xAB\u0421\u0431\u044B\u0442\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793860
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u044B \u0438 \u0440\u043E\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793861
    m_Localized: "\u0412\u044B\u0438\u0433\u0440\u0430\u0439\u0442\u0435 \u0442\u0435\u043D\u0434\u0435\u0440 \u0444\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u0438 \u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u0435 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u0432 \u0441\u0440\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793862
    m_Localized: "\u0420\u0435\u0433\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u0430\u044F \u0444\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u044F \u0442\u0445\u044D\u043A\u0432\u043E\u043D\u0434\u043E \u043E\u0431\u044A\u044F\u0432\u0438\u043B\u0430 \u0442\u0435\u043D\u0434\u0435\u0440 \u043D\u0430 200 \u0434\u043E\u0431\u043E\u043A\u043E\u0432 \u0441 \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u043E\u0439 \u0437\u0430 \u0434\u0432\u0430 \u043C\u0435\u0441\u044F\u0446\u0430. \u041F\u043E\u0434\u0430\u0439\u0442\u0435 \u0437\u0430\u044F\u0432\u043A\u0443 \u0432 \u043F\u0435\u0440\u0432\u043E\u043C \u043C\u0435\u0441\u044F\u0446\u0435, \u043D\u0430\u0440\u0430\u0441\u0442\u0438\u0442\u0435 \u0432\u044B\u043F\u0443\u0441\u043A, \u043F\u0440\u0438 \u043D\u0443\u0436\u0434\u0435 \u0432\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u043A\u0440\u0435\u0434\u0438\u0442, \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u0443\u0439\u0442\u0435 \u043F\u0440\u043E\u0434\u0443\u043A\u0446\u0438\u044E, \u0432\u043D\u0435\u0434\u0440\u0438\u0442\u0435 \u043C\u043E\u0434\u0443\u043B\u0438 \u0446\u0438\u0444\u0440\u043E\u0432\u0438\u0437\u0430\u0446\u0438\u0438. \u0426\u0435\u043B\u044C \u2014 \u0437\u0430\u043A\u0440\u044B\u0442\u044C \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u0431\u0435\u0437 \u043F\u0440\u043E\u0441\u0440\u043E\u0447\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793863
    m_Localized: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430: \u0437\u0430\u044F\u0432\u043A\u0438 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u043C\u0435\u0441\u044F\u0446\u0430, \u043F\u043E\u0431\u0435\u0436\u0434\u0430\u0435\u0442 \u043B\u0443\u0447\u0448\u0438\u0439 \u0431\u0430\u043B\u043B \u2014 \u0446\u0435\u043D\u0430, \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F, \u0438\u0441\u0442\u043E\u0440\u0438\u044F \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430. \u041F\u043E\u0441\u0442\u0430\u0432\u043A\u0438 \u043F\u043E \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0443 \u0438\u0434\u0443\u0442 \u0440\u0430\u043D\u044C\u0448\u0435 \u0440\u043E\u0437\u043D\u0438\u0446\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793864
    m_Localized: "\u0418\u0442\u043E\u0433\u0438 \u0442\u0440\u0451\u0445 \u043B\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793865
    m_Localized: "\u0420\u0435\u0439\u0442\u0438\u043D\u0433 \u043F\u043E \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438. \u041F\u0430\u0440\u0442\u0438\u044E \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0431\u0435\u0437 \u0441\u0440\u043E\u043A\u0430."
