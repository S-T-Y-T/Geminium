    m_Localized: "\u0414\u0432\u043E\u0439\u043D\u0438\u043A \u043D\u0435 \u043D\u0430\u0448\u0451\u043B \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u043E\u0432\u043E\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0437\u0430\u043C\u0435\u0442\u043D\u043E \u0441\u043E\u043A\u0440\u0430\u0442\u044F\u0442 \u043F\u0443\u0442\u044C \u0433\u0440\u0443\u0437\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 330933079822343
    m_Localized: "{0} \u2116{1}: \u043F\u0443\u0442\u044C \u043A\u043E\u0440\u043E\u0447\u0435 \u043D\u0430 {2} \u043A\u043B\u0435\u0442\u043A\u0438 \u043D\u0430 \u0438\u0437\u0434\u0435\u043B\u0438\u0435, \u043F\u0435\u0440\u0435\u043D\u043E\u0441 {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 330933079822344
    m_Localized: "\u0422\u043E\u0447\u043D\u043E\u0435 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0441\u0442\u0430\u043D\u043A\u0430 \u0432\u043C\u0435\u0441\u0442\u043E \u0433\u0440\u0443\u0431\u043E\u0439 \u043E\u0446\u0435\u043D\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 330933079822345
    m_Localized: "\u0422\u041E \u043F\u043E \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044E \u0441\u0442\u0430\u043D\u043A\u0430 (\u043D\u0435 \u0432\u044B\u0448\u0435 55%), \u0430 \u043D\u0435 \u043F\u043E \u0441\u0447\u0451\u0442\u0447\u0438\u043A\u0443 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 330933079822346
    m_Localized: "\xAB\u0427\u0442\u043E \u0435\u0441\u043B\u0438\xBB \u0434\u043B\u044F \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u043A\u0438: \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438, \u043F\u0435\u0440\u0435\u043D\u043E\u0441 \u0441\u0442\u0430\u043D\u043A\u0430 \u0432 5 \u0440\u0430\u0437 \u0434\u0435\u0448\u0435\u0432\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 330933079822347
    m_Localized: "\u041E\u0442\u0445\u043E\u0434\u044B \u0442\u043A\u0430\u043D\u0438 \u043F\u0440\u0438 \u0440\u0430\u0441\u043A\u0440\u043E\u0435 4% \u0432\u043C\u0435\u0441\u0442\u043E 12%."
    m_Metadata:
      m_Items: []
