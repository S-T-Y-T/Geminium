    m_Metadata:
      m_Items: []
  - m_Id: 330933100793872
    m_Localized: "Slotga saqla\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793873
    m_Localized: '{0}-slot'
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793874
    m_Localized: "Avtosaqla\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793875
    m_Localized: "b\xF6\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793876
    m_Localized: "Saqla\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793877
    m_Localized: "Yukla\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793878
    m_Localized: "\xD6\xE7iri\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793879
    m_Localized: "\xD6yin saqlandi."
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793880
    m_Localized: "{0}, {1}-oy, kapitalizatsiya {2} \xB7 {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793881
    m_Localized: "Avtosaqla\u015F \u2014 har oy oxirida."
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793882
    m_Localized: "\xD6yin yuklanmoqda"
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793883
    m_Localized: 'Qarorlar takrorlanmoqda: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793884
    m_Localized: "Yuklab b\xF6lmadi"
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793885
    m_Localized: "\xD6yin ma\u02BClumotlari \xF6zgardi"
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793886
    m_Localized: "Saqla\u015F bo\u015Fqa balans bilan qilingan, \xF6yin avvalgidan bo\u015Fqa\xE7a keti\u015Fi mumkin. Baribir yuklansinmi?"
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793887
    m_Localized: "Raqamla\u015Ftiri\u015Fning turli modullari bilan \xF6\u015Fa fabrika, grafikasiz. Samara \u2014 \xF6\u015Fa seedlarda baza bilan foyda farqi."
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793888
    m_Localized: Seed
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793889
    m_Localized: Oylar
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793890
    m_Localized: "I\u015Fga tu\u015Firi\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793891
    m_Localized: "Hisoblanmoqda: {0} ta progon\u2026 Bir ne\xE7a daqiqa oladi."
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793892
    m_Localized: "Tayyor. Excel u\xE7un jadvallar: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 330933100793893
    m_Localized: Ssenariy
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376768
    m_Localized: "Foyda \xF6si\u015Fi, mln/oy"
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376769
    m_Localized: "{0} \xB1 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376770
    m_Localized: ROI
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376771
    m_Localized: "Qoplani\u015F, oy"
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376772
    m_Localized: NPV
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376773
    m_Localized: A. Modulsiz baza
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376774
    m_Localized: "B. IoT + ba\u015Foratli TX"
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376775
    m_Localized: "C0. Yomon joyla\u015Fuv"
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376776
    m_Localized: C. Raqamli egizak (C0 ga nisbatan)
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376777
    m_Localized: "D. SI-bi\xE7i\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376778
    m_Localized: E. SI sifat nazorati
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376779
    m_Localized: F. Talab prognozi
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376780
    m_Localized: "G. SI narx belgila\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376781
    m_Localized: "H. Bar\xE7a modullar"
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376782
    m_Localized: "I. Bar\xE7a modullar + davlat dasturi"
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376783
    m_Localized: 'Bozorda voqea: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376784
    m_Localized: "EVA k\xF6pik {1} oyga {0} ga qimmatla\u015Fdi."
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376785
    m_Localized: "Paxta {1} oyga {0} ga qimmatla\u015Fdi."
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376786
    m_Localized: "Yetkazib beruv\xE7ilarda fors-major: yetkazib beri\u015Flar tez-tez buzilmoqda ({1} oy)."
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376787
    m_Localized: "Bozorga yomon xoma\u015Fyo partiyasi tu\u015Fdi \u2014 yetkazib beri\u015Flarni tek\u015Firing."
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376788
    m_Localized: 'Valyuta zarbasi: import {1} oyga {0} ga qimmatroq.'
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376789
    m_Localized: "\xABRaqamli \xD6zbekiston\xBB davlat dasturi: raqamli modullarni joriy eti\u015F narxining {0} i qoplanadi ({1} oy)."
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376790
    m_Localized: "Elektr \xE7eklovlari: dastgohlar {0} kamroq i\u015Flaydi ({1} oy)."
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376791
    m_Localized: "Gripp epidemiyasi: odamlar kasal, dastgohlar {0} kamroq i\u015Flaydi ({1} oy)."
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376792
    m_Localized: "Sport yuksali\u015Fi: ekipirovkaga talab {1} oyga {0} ga \xF6sdi."
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376793
    m_Localized: "Tender ({0}): {1}, {2} dona, donasi {3} dan o\u015Fmasin."
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376794
    m_Localized: "Tender \u011Folibi ({1}, {2}) \u2014 {0}: donasi {3}."
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376795
    m_Localized: "{0} {1} narxini {2}% ga tu\u015Firdi: {3}."
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376796
    m_Localized: "{0} {1} narxini {2}% ga o\u015Firdi: {3}."
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376797
    m_Localized: "{0} sexni kengaytirmoqda: yangi dastgoh \u2014 {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376798
    m_Localized: '{0} reklamaga oyiga {1} sarflamoqda.'
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376799
    m_Localized: "{0} ambassador bilan \u015Fartnoma imzoladi: {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376800
    m_Localized: "omborda mahsulot yi\u011Filib qoldi"
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376801
    m_Localized: "raqobat\xE7ilar arzonroq sotmoqda"
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376802
    m_Localized: talab kutilganidan past
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376803
    m_Localized: xaridorlarga mahsulot yetmadi
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376804
    m_Localized: "raqobat\xE7ilar qimmatroq sotmoqda"
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376805
    m_Localized: "xarajatlar \xF6sdi"
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376806
    m_Localized: "operatorlar y\xF6q"
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376807
    m_Localized: "xoma\u015Fyo va yarim tayyor mahsulot y\xF6q"
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376808
    m_Localized: "buzili\u015Flar"
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376809
    m_Localized: TX
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376810
    m_Localized: "Bu oy u\xE7un hisobot y\xF6q."
    m_Metadata:
      m_Items: []
  - m_Id: 330933113376811
    m_Localized: "Oylik tu\u015Fum \u2014 {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348288
    m_Localized: "Oylik tu\u015Fum \u2014 {0} (\xF6tgan oyga nisbatan {1})."
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348289
    m_Localized: "Sof foyda \u2014 {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348290
    m_Localized: "Zarar \u2014 {0}."
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348291
    m_Localized: "{0} ta yaroqli mahsulot \xE7iqarildi, nuqson {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348292
    m_Localized: "Eng yax\u015Fi sotilgan mahsulot \u2014 {0}: {1} dona."
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348293
    m_Localized: "{0} ta sotuv boy berildi \u2014 mahsulot yetmadi."
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348294
    m_Localized: "Eng k\xF6p bekor turi\u015F \u2014 {0}: {1} soat."
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348295
    m_Localized: 'Yutilgan tenderlar: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348296
    m_Localized: Xaridorlar {0} ta nuqsonli mahsulotni qaytardi.
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348297
    m_Localized: Hisobda {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348298
    m_Localized: "\xAB{0}\xBB mahsuloti y\xF6q."
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348299
    m_Localized: "Pul yetmaydi: {0:N0} s\xF6m kerak, hisobda {1:N0}."
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348300
    m_Localized: "Paket b\xF6\u015F."
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348301
    m_Localized: "Narx noldan katta b\xF6li\u015Fi kerak."
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348302
    m_Localized: "Reja manfiy b\xF6li\u015Fi mumkin emas."
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348303
    m_Localized: "\xAB{0}\xBB mahsuloti hali o\xE7ilmagan."
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348304
    m_Localized: "I\u015F grafigi berilmagan."
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348305
    m_Localized: "\xAB{0}\xBB yetkazib beruv\xE7isi y\xF6q."
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348306
    m_Localized: "\xAB{0}\xBB u\xE7un eng kam partiya \u2014 {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348307
    m_Localized: "Kredit summasi noldan katta b\xF6li\u015Fi kerak."
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348308
    m_Localized: "Kredit muddati \u2014 1 dan {0} oyga\xE7a."
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348309
    m_Localized: "Bank ortiq bermaydi: qarz \xE7egarasi {0:N0} s\xF6m."
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348310
    m_Localized: "Bu modul i\u015Flamayapti."
    m_Metadata:
      m_Items: []
  - m_Id: 330933134348311
    m_Localized: "SI narx belgila\u015F moduli y\xF6q."
    m_Metadata:
      m_Items: []
  - m_Id: 330933142736896
    m_Localized: "\xAB{0}\xBB dastgohi y\xF6q."
    m_Metadata:
      m_Items: []
  - m_Id: 330933142736897
    m_Localized: "\u2116{0} obyekt y\xF6q."
    m_Metadata:
      m_Items: []
  - m_Id: 330933142736898
    m_Localized: "\u2116{0} dastgoh y\xF6q."
    m_Metadata:
      m_Items: []
  - m_Id: 330933142736899
    m_Localized: "Bo\u015Fqa q\xF6\u015Fim\xE7a bino ijaraga olib b\xF6lmaydi."
    m_Metadata:
      m_Items: []
  - m_Id: 330933142736900
    m_Localized: "T\xF6rtbur\xE7ak sex devoridan \xE7iqib ketadi."
    m_Metadata:
      m_Items: []
  - m_Id: 330933142736901
    m_Localized: "Reklama byudjeti manfiy b\xF6li\u015Fi mumkin emas."
    m_Metadata:
      m_Items: []
  - m_Id: 330933142736902
    m_Localized: "\xAB{0}\xBB kompaniya ambassadori emas."
    m_Metadata:
      m_Items: []
  - m_Id: 330933142736903
    m_Localized: "\u2116{0} nomzod endi bozorda y\xF6q."
    m_Metadata:
      m_Items: []
  - m_Id: 330933142736904
    m_Localized: "\u2116{0} nomzodni bo\u015Fqa kompaniya i\u015Fga olmoqda."
    m_Metadata:
      m_Items: []
  - m_Id: 330933142736905
    m_Localized: "\u2116{0} xodim y\xF6q."
    m_Metadata:
      m_Items: []
  - m_Id: 330933142736906
    m_Localized: "Smena \u2014 0, 1 yoki 2."
    m_Metadata:
      m_Items: []
  - m_Id: 330933142736907
    m_Localized: "Bu kasb egasi dastgohda i\u015Flamaydi."
    m_Metadata:
      m_Items: []
  - m_Id: 330933142736908
    m_Localized: "I\u015F haqi noldan katta b\xF6li\u015Fi kerak."
    m_Metadata:
      m_Items: []
  - m_Id: 330933142736909
    m_Localized: "Q\xF6\u015Fim\xE7a i\u015F \u2014 0 dan {0} soatga\xE7a."
    m_Metadata:
      m_Items: []
  - m_Id: 330933142736910
    m_Localized: "Transport partiyasi \u2014 1 dan {0} ga\xE7a."
    m_Metadata:
      m_Items: []
  - m_Id: 330933142736911
    m_Localized: "TX orali\u011Fi kamida bir operatsiya."
    m_Metadata:
      m_Items: []
  - m_Id: 330933151125504
    m_Localized: "Bu kampaniyaning keyingi top\u015Firiqlarida o\xE7iladi."
    m_Metadata:
      m_Items: []
  - m_Id: 330933151125505
    m_Localized: "Kompaniya bankrot b\xF6ldi."
    m_Metadata:
      m_Items: []
  - m_Id: 330933151125506
    m_Localized: "\u2116{0} tender ariza qabul qilmaydi."
    m_Metadata:
      m_Items: []
  - m_Id: 330933151125507
    m_Localized: "Ariza narxi noldan katta b\xF6li\u015Fi kerak."
    m_Metadata:
      m_Items: []
  - m_Id: 330933151125508
    m_Localized: "Narx \xE7egaradan yuqori: birligiga {0:N0} s\xF6mdan o\u015Fmasin."
    m_Metadata:
      m_Items: []
  - m_Id: 330933151125509
    m_Localized: "Kamida {0:0} obr\xF6 kerak, kompaniyada {1:0}."
    m_Metadata:
      m_Items: []
  - m_Id: 330933151125510
    m_Localized: "\xAB{0}\xBB u\xE7un sertifikat kerak."
    m_Metadata:
      m_Items: []
  - m_Id: 330933151125511
    m_Localized: "\u2116{0} turnir e\u02BClon qilinmagan yoki allaqa\xE7on \xF6tgan."
    m_Metadata:
      m_Items: []
  - m_Id: 330933151125512
    m_Localized: "Kompaniya bu turnirga allaqa\xE7on homiylik qilmoqda."
    m_Metadata:
      m_Items: []
  - m_Id: 330933151125513
    m_Localized: "\xAB{0}\xBB sport\xE7isi y\xF6q."
    m_Metadata:
      m_Items: []
  - m_Id: 330933151125514
    m_Localized: "Sport\xE7ining allaqa\xE7on \u015Fartnomasi bor."
    m_Metadata:
      m_Items: []
  - m_Id: 330933151125515
    m_Localized: "Bu mahsulot u\xE7un sertifikat allaqa\xE7on bor yoki tek\u015Firuv davom etmoqda."
    m_Metadata:
      m_Items: []
  - m_Id: 330933151125516
    m_Localized: "{0} moduli y\xF6q."
    m_Metadata:
      m_Items: []
  - m_Id: 330933151125517
    m_Localized: "Modul allaqa\xE7on i\u015Flayapti."
    m_Metadata:
      m_Items: []
  - m_Id: 330933151125518
    m_Localized: Avval {0} moduli kerak.
    m_Metadata:
      m_Items: []
  - m_Id: 330933151125519
    m_Localized: "Obyekt sex devoridan \xE7iqib ketadi."
    m_Metadata:
      m_Items: []
  - m_Id: 330933151125520
    m_Localized: "Obyektni y\xF6lakka q\xF6yib b\xF6lmaydi."
    m_Metadata:
      m_Items: []
