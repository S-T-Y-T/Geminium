    m_Metadata:
      m_Items: []
  - m_Id: 330933079822341
    m_Localized: "Narxlarni avtomatik q\xF6yi\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 330933079822342
    m_Localized: "Egizak yuklar y\xF6lini sezilarli qisqartiradigan k\xF6\xE7iri\u015Flarni topmadi."
    m_Metadata:
      m_Items: []
  - m_Id: 330933079822343
    m_Localized: "{0} \u2116{1}: y\xF6l har mahsulotga {2} katak qisqaradi, k\xF6\xE7iri\u015F {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 330933079822344
    m_Localized: "Har bir dastgohning aniq holati \u2014 taxminiy baho \xF6rniga."
    m_Metadata:
      m_Items: []
  - m_Id: 330933079822345
    m_Localized: "TX dastgoh holatiga qarab (55% dan o\u015Fmaganda), operatsiyalar soniga qarab emas."
    m_Metadata:
      m_Items: []
  - m_Id: 330933079822346
    m_Localized: "Joyla\u015Fuv u\xE7un \xABagar \u015Funday b\xF6lsa\xBB: k\xF6\xE7iri\u015Flarni taklif qiladi, dastgohni k\xF6\xE7iri\u015F 5 baravar arzon."
    m_Metadata:
      m_Items: []
  - m_Id: 330933079822347
    m_Localized: "Bi\xE7i\u015Fda mato \xE7iqindisi 12% \xF6rniga 4%."
    m_Metadata:
      m_Items: []
  - m_Id: 330933079822348
    m_Localized: "Kamera har bir mahsulotni tek\u015Firadi va nazorat\xE7isiz nuqsonning 97% ini topadi."
    m_Metadata:
      m_Items: []
  - m_Id: 330933079822349
    m_Localized: "Mavsumni hisobga olgan talab prognozi asosida i\u015Flab \xE7iqari\u015F rejasi."
    m_Metadata:
      m_Items: []
  - m_Id: 330933079822350
    m_Localized: "Har oy \u2014 eng katta kutilgan marjali narx."
    m_Metadata:
      m_Items: []
  - m_Id: 330933079822351
    m_Localized: "Grafiklar birin\xE7i oydan keyin paydo b\xF6ladi."
    m_Metadata:
      m_Items: []
  - m_Id: 330933079822352
